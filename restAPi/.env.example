DB_URL=jdbc:postgresql://localhost:5432/wordwolf
DB_USERNAME=wordwolf
DB_PASSWORD=replace-me

# Optional Docker Compose settings
DB_NAME=wordwolf
BACKEND_PORT=8080

# Root Compose: Nginx frontend and API port
HTTP_PORT=8080

# Root Compose: existing GGUF file mounted read-only (default: ~/models/...)
# LOCAL_MODEL_PATH=/home/you/models/madlad400-3b-mt-q8_0.gguf
LLAMA_THREADS=4
LOCAL_AI_TIMEOUT_SECONDS=60
# For a backend launched outside Compose:
# LOCAL_AI_URL=http://localhost:8081

# Optional Flutter build mirrors when pub.dev is inaccessible.
# PUB_HOSTED_URL=https://pub.flutter-io.cn
# FLUTTER_STORAGE_BASE_URL=https://storage.flutter-io.cn

# Root Compose runs Julia-1 locally in a separate container.
JULIA_CPU_THREADS=4
# Outside Compose, leave empty to disable or use a local HTTP origin.
# LOCAL_DECISION_URL=http://localhost:8082
